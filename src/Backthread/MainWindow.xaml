<Window
    x:Class="Backthread.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="回线 · Backthread">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="Hero" Color="#E6F4EE"/>
                        <SolidColorBrush x:Key="Signal" Color="#14674F"/>
                        <SolidColorBrush x:Key="BrandTile" Color="#D1EEE0"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="Hero" Color="#172620"/>
                        <SolidColorBrush x:Key="Signal" Color="#91E6BF"/>
                        <SolidColorBrush x:Key="BrandTile" Color="#244137"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="Hero" Color="{ThemeResource SystemColorWindowColor}"/>
                        <SolidColorBrush x:Key="Signal" Color="{ThemeResource SystemColorWindowTextColor}"/>
                        <SolidColorBrush x:Key="BrandTile" Color="{ThemeResource SystemColorWindowColor}"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="Quiet" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Padding="24,15" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource BrandTile}">
                        <Viewbox Width="23" Height="23">
                            <Path Data="M 20,5 L 11,5 C 6,5 4,8 4,12 C 4,16 7,19 11,19 L 20,19 M 16,1 L 20,5 L 16,9"
                                  Stroke="{ThemeResource Signal}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="回线" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="B A C K T H R E A D" FontSize="10" Foreground="{ThemeResource Signal}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Content="暂停记录" Click="TogglePause"/>
                    <Button Content="···" Padding="10,4" AutomationProperties.Name="更多操作">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="清空本次记录" Click="ClearSession"/>
                                <MenuFlyoutItem Text="快捷键与隐私" Click="ShowHelp"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="Columns" Padding="24,6,24,24" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState>
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="805"/></VisualState.StateTriggers>
                            </VisualState>
                            <VisualState>
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MainColumn.(Grid.ColumnSpan)" Value="2"/>
                                    <Setter Target="StackColumn.(Grid.Column)" Value="0"/>
                                    <Setter Target="StackColumn.(Grid.ColumnSpan)" Value="2"/>
                                    <Setter Target="StackColumn.(Grid.Row)" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <StackPanel x:Name="MainColumn" Spacing="16">
                        <Border Background="{ThemeResource Hero}" Padding="20,18" CornerRadius="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="↶  建议回访 / 01" FontSize="13" Foreground="{ThemeResource Signal}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CandidateTitle" Text="被打断了？从这里接着做。" FontSize="27"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CandidateDetails" Style="{StaticResource Quiet}"
                                           Text="使用一阵后，回线会在这里指出你刚才停留较久的窗口。"/>
                                <Button x:Name="ReturnButton" Style="{StaticResource AccentButtonStyle}" Content="回到原窗口  →"
                                        Click="ReturnToCandidate" IsEnabled="False" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="7">
                            <Grid>
                                <TextBlock Text="切换轨迹" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TrailCount" Text="最近 0 段" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource Quiet}" FontSize="12"/>
                            </Grid>
                            <TextBlock Text="从新到旧 · 点一段，回到那扇窗口。" Style="{StaticResource Quiet}" FontSize="13"/>
                            <StackPanel x:Name="TrailRows" Spacing="5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="StackColumn" Grid.Column="1" CornerRadius="16" Padding="17"
                            VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="11">
                            <TextBlock Text="↧  手动留线 / 02" FontSize="13" Foreground="{ThemeResource Signal}" FontWeight="SemiBold"/>
                            <TextBlock Text="复工栈" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="先把这件事留在栈顶。临时任务也被打断时，再压入一层。回来时，先接最近的一件。" Style="{StaticResource Quiet}"/>
                            <Button x:Name="ComposeButton" Content="＋ 添加检查点" Click="OpenComposerClick"/>
                            <Border x:Name="Composer" Visibility="Collapsed" Padding="12" CornerRadius="10" Background="{ThemeResource Hero}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ComposeTarget" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontWeight="SemiBold"/>
                                    <TextBox x:Name="NoteBox" Header="下一步做什么？" PlaceholderText="例如：从第 3 段继续修改" MaxLength="160"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Content="压入栈顶" Click="SaveCheckpoint"/>
                                        <Button Content="取消" Click="CancelCheckpoint"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="StackRows" Spacing="7"/>
                            <StackPanel x:Name="StackActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button x:Name="PopButton" Content="返回并出栈" Click="ResumeTop"/>
                                <Button Content="移除栈顶" Click="DiscardTop"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,9"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock x:Name="Hint" Text="只记本次会话 · 不截屏 · 最小化后继续工作"
                               FontSize="11" Style="{StaticResource Quiet}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
